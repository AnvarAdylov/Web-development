        <mxCell id="FuF39vw4pi-8QjGyg8M0-108" value="&lt;b style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;Beijing&lt;/b&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;,&lt;/span&gt;&lt;sup style=&quot;line-height: 1; unicode-bidi: isolate; text-wrap: nowrap; font-size: 11.2px; color: rgb(32, 33, 34); font-family: sans-serif; text-align: start; background-color: rgb(255, 255, 255);&quot; class=&quot;reference&quot; id=&quot;cite_ref-8&quot;&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none; overflow-wrap: break-word;&quot; href=&quot;https://en.wikipedia.org/wiki/Beijing#cite_note-8&quot;&gt;[a]&lt;/a&gt;&lt;/sup&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;Chinese postal romanization&quot; href=&quot;https://en.wikipedia.org/wiki/Chinese_postal_romanization&quot;&gt;alternatively romanized&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;as&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;Peking&lt;/b&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;,&lt;/span&gt;&lt;sup style=&quot;line-height: 1; unicode-bidi: isolate; text-wrap: nowrap; font-size: 11.2px; color: rgb(32, 33, 34); font-family: sans-serif; text-align: start; background-color: rgb(255, 255, 255);&quot; class=&quot;reference&quot; id=&quot;cite_ref-11&quot;&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none; overflow-wrap: break-word;&quot; href=&quot;https://en.wikipedia.org/wiki/Beijing#cite_note-11&quot;&gt;[b]&lt;/a&gt;&lt;/sup&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;is the&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;Capital city&quot; href=&quot;https://en.wikipedia.org/wiki/Capital_city&quot;&gt;capital&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;of&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;China&quot; href=&quot;https://en.wikipedia.org/wiki/China&quot;&gt;China&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;. With about 22 million residents,&lt;/span&gt;&lt;sup style=&quot;line-height: 1; unicode-bidi: isolate; text-wrap: nowrap; font-size: 11.2px; color: rgb(32, 33, 34); font-family: sans-serif; text-align: start; background-color: rgb(255, 255, 255);&quot; class=&quot;reference&quot; id=&quot;cite_ref-12&quot;&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none; overflow-wrap: break-word;&quot; href=&quot;https://en.wikipedia.org/wiki/Beijing#cite_note-12&quot;&gt;[9]&lt;/a&gt;&lt;/sup&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;Beijing is the world&#39;s&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;List of national capitals by population&quot; href=&quot;https://en.wikipedia.org/wiki/List_of_national_capitals_by_population&quot;&gt;most populous national capital city&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;as well as China&#39;s&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;List of cities in China by population&quot; href=&quot;https://en.wikipedia.org/wiki/List_of_cities_in_China_by_population&quot;&gt;second largest city&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;after&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;Shanghai&quot; href=&quot;https://en.wikipedia.org/wiki/Shanghai&quot;&gt;Shanghai&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;.&lt;/span&gt;&lt;sup style=&quot;line-height: 1; unicode-bidi: isolate; text-wrap: nowrap; font-size: 11.2px; color: rgb(32, 33, 34); font-family: sans-serif; text-align: start; background-color: rgb(255, 255, 255);&quot; class=&quot;reference&quot; id=&quot;cite_ref-13&quot;&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none; overflow-wrap: break-word;&quot; href=&quot;https://en.wikipedia.org/wiki/Beijing#cite_note-13&quot;&gt;[10]&lt;/a&gt;&lt;/sup&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;It is located in&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;North China&quot; href=&quot;https://en.wikipedia.org/wiki/North_China&quot;&gt;Northern China&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;, and is governed as a&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;Direct-administered municipalities of China&quot; class=&quot;mw-redirect&quot; href=&quot;https://en.wikipedia.org/wiki/Direct-administered_municipalities_of_China&quot;&gt;municipality&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;under the direct administration of the&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;Government of the People&#39;s Republic of China&quot; class=&quot;mw-redirect&quot; href=&quot;https://en.wikipedia.org/wiki/Government_of_the_People%27s_Republic_of_China&quot;&gt;State Council&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;with&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;List of administrative divisions of Beijing&quot; href=&quot;https://en.wikipedia.org/wiki/List_of_administrative_divisions_of_Beijing&quot;&gt;16 urban, suburban, and rural districts&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;.&lt;/span&gt;&lt;sup style=&quot;line-height: 1; unicode-bidi: isolate; text-wrap: nowrap; font-size: 11.2px; color: rgb(32, 33, 34); font-family: sans-serif; text-align: start; background-color: rgb(255, 255, 255);&quot; class=&quot;reference&quot; id=&quot;cite_ref-figures_14-0&quot;&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none; overflow-wrap: break-word;&quot; href=&quot;https://en.wikipedia.org/wiki/Beijing#cite_note-figures-14&quot;&gt;[11]&lt;/a&gt;&lt;/sup&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;Beijing is mostly surrounded by&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;Hebei Province&quot; class=&quot;mw-redirect&quot; href=&quot;https://en.wikipedia.org/wiki/Hebei_Province&quot;&gt;Hebei Province&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;with the exception of neighboring&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;Tianjin&quot; href=&quot;https://en.wikipedia.org/wiki/Tianjin&quot;&gt;Tianjin&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;to the southeast; together, the three divisions form the&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;Jingjinji&quot; class=&quot;mw-redirect&quot; href=&quot;https://en.wikipedia.org/wiki/Jingjinji&quot;&gt;Jingjinji&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;Megalopolises in China&quot; href=&quot;https://en.wikipedia.org/wiki/Megalopolises_in_China&quot;&gt;megalopolis&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;and the&amp;nbsp;&lt;/span&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none rgb(255, 255, 255); overflow-wrap: break-word; font-family: sans-serif; font-size: 14px; text-align: start;&quot; title=&quot;National capital region&quot; class=&quot;mw-redirect&quot; href=&quot;https://en.wikipedia.org/wiki/National_capital_region&quot;&gt;national capital region&lt;/a&gt;&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 14px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;of China.&lt;/span&gt;&lt;sup style=&quot;line-height: 1; unicode-bidi: isolate; text-wrap: nowrap; font-size: 11.2px; color: rgb(32, 33, 34); font-family: sans-serif; text-align: start; background-color: rgb(255, 255, 255);&quot; class=&quot;reference&quot; id=&quot;cite_ref-basic_15-0&quot;&gt;&lt;a style=&quot;text-decoration-line: none; color: rgb(51, 102, 204); background: none; overflow-wrap: break-word;&quot; href=&quot;https://en.wikipedia.org/wiki/Beijing#cite_note-basic-15&quot;&gt;[12]&lt;/a&gt;&lt;/sup&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="FuF39vw4pi-8QjGyg8M0-58">
