        <mxCell id="4ATrvjR8VIuc0k-QCOvy-201" value="CREATE TABLE Curriculum (&lt;br&gt;id SERIAL,&lt;br&gt;    group_id SERIAL,&lt;br&gt;topic_id SERIAL,&lt;br&gt;time: TIMESTAMP,&lt;br&gt;PRIMARY KEY (id),&lt;br&gt;FOREIGN KEY (group_id) REFERENCES Groups(id),&lt;br&gt;FOREIGN KEY (topic_id) REFERENCES Topics(id),&lt;br&gt;);" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
