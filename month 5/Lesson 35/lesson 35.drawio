        <mxCell id="4ATrvjR8VIuc0k-QCOvy-146" value="Произведения разбиты по типу произведений (статья, учебник, справочник, повесть, роман и т.д.)." style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="385" y="-10" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="4ATrvjR8VIuc0k-QCOvy-147" value="Есть писатели, которые пишут произведения." style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="385" y="-390" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4ATrvjR8VIuc0k-QCOvy-148" value="Есть категории произведений, определяющие их жанр/тематику: художественная литература, фантастика, техническая литература, физика, теоретическая механика)." style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="415" y="-160" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="4ATrvjR8VIuc0k-QCOvy-150" value="CREATE TABLE Works (&lt;br&gt;id SERIAL,&lt;br&gt;title VARCHAR,&lt;br&gt;author_id SERIAL,&lt;br&gt;genre_id SERIAL,&lt;br&gt;type_id SERIAL,&lt;br&gt;PRIMARY KEY (id),&lt;br&gt;FOREIGN KEY (author_id) REFERENCES Authors(id),&lt;br&gt;FOREIGN KEY (genre_id) REFERENCES Genres(id),&lt;br&gt;FOREIGN KEY (type_id) REFERENCES Types(id)&lt;br&gt;);" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-210" y="-220" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="4ATrvjR8VIuc0k-QCOvy-151" value="CREATE TABLE Authors (&lt;br&gt;id SERIAL,&lt;br&gt;name: VARCHAR,&lt;div&gt;lastname: VARCHAR,&lt;br&gt;year: SERIAL,&lt;br&gt;works_id SERIAL,&lt;br&gt;PRIMARY KEY (id),&lt;br&gt;FOREIGN KEY (works_id) REFERENCES Works(id),&lt;br&gt;);&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="385" y="-350" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="4ATrvjR8VIuc0k-QCOvy-152" value="CREATE TABLE Types (&lt;br&gt;id SERIAL,&lt;br&gt;name: VARCHAR,&lt;div&gt;description: VARCHAR,&lt;br&gt;works_id SERIAL,&lt;br&gt;PRIMARY KEY (id),&lt;br&gt;FOREIGN KEY (works_id) REFERENCES Works(id),&lt;br&gt;);&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="385" y="50" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="4ATrvjR8VIuc0k-QCOvy-153" value="CREATE TABLE Genres (&lt;br&gt;id SERIAL,&lt;br&gt;name_of_genre: VARCHAR,&lt;div&gt;description: VARCHAR,&lt;/div&gt;&lt;div&gt;subgenre_id SERIAL,&lt;br&gt;works_id SERIAL,&lt;br&gt;PRIMARY KEY (id),&lt;br&gt;FOREIGN KEY (works_id) REFERENCES Works(id),&lt;br&gt;FOREIGN KEY (subgenre_id) REFERENCES Genres(id),&lt;br&gt;&lt;/div&gt;&lt;div&gt;);&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="-170" width="330" height="180" as="geometry" />
        </mxCell>
